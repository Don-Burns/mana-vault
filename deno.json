{
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "db:download": "deno run -A tools/download-bulk.ts",
    "db:art": "deno run -A tools/download-art.ts",
    "db:build": "deno run -A tools/build-hashdb.ts",
    "db:release": "deno task db:download && deno task db:art && deno task db:build && deno run -A tools/release-db.ts",
    "bench:matcher": "deno run -A docs/benchmarks/bench-matcher.ts",
    "opencv:download": "deno run -A tools/download-opencv.ts",
    "test": "deno test -A",
    "test:e2e": "deno run -A npm:playwright test",
    "test:e2e:install": "deno run -A npm:playwright install --with-deps chromium"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@playwright/test": "npm:@playwright/test@1.62.1",
    "@sqlite.org/sqlite-wasm": "npm:@sqlite.org/sqlite-wasm@3.53.0-build1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/csv": "npm:@jsr/std__csv@^1.0.6"
  },
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true
  }
}
