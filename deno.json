{
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "db:download": "deno run -A tools/download-bulk.ts",
    "db:art": "deno run -A tools/download-art.ts",
    "db:build": "deno run -A tools/build-hashdb.ts"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@techstark/opencv-js": "npm:@techstark/opencv-js@4.12.0-release.1"
  },
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true
  }
}
